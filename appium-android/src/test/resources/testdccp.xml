<!DOCTYPE suite SYSTEM "https://testng.org/testdccp-1.1.dtd">

<suite name="DataConsistencyCrossPlatformSuite">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="TC01_CrossPlatformProductInformationConsistency">
        <classes>
            <class name="com.saucelabs.appium.CrossPlatformConsistencyTests">
                <methods>
                    <include name="verifyBackpackConsistencyBetweenWebAndMobile"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>