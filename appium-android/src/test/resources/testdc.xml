<!DOCTYPE suite SYSTEM "https://testng.org/testdc-1.1.dtd">

<suite name="DataConsistencySuite">

    <test name="TC01_ProductInformationConsistency">
        <classes>
            <class name="com.saucelabs.appium.DataConsistencyTests">
                <methods>
                    <include name="verifyProductInformationConsistencyAcrossPages"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="TC02_CartStateConsistency">
        <classes>
            <class name="com.saucelabs.appium.DataConsistencyTests">
                <methods>
                    <include name="verifyCartStateConsistencyDuringNavigation"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="TC03_CartBadgeConsistency">
        <classes>
            <class name="com.saucelabs.appium.DataConsistencyTests">
                <methods>
                    <include name="verifyCartBadgeRemainsConsistentDuringNavigation"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>